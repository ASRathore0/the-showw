<IfModule mod_rewrite.c>
    DirectoryIndex index.php index.html

    RewriteEngine On
    RewriteBase /

    # Pass Authorization Headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Direct static file serving from frontend/dist (PNG, JPG, SVG, JS, CSS)
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # 2. Route API & SPA requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
