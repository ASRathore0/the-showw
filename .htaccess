<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forward API requests to Laravel Backend (backend/public/index.php)
    RewriteCond %{REQUEST_URI} ^/api [NC]
    RewriteRule ^api/?(.*)$ backend/public/index.php/$1 [L,QSA]

    # 2. Forward storage uploaded files to Laravel Storage
    RewriteCond %{REQUEST_URI} ^/storage [NC]
    RewriteRule ^storage/(.*)$ backend/public/storage/$1 [L]

    # 3. Serve Frontend Build static files if they exist
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist%{REQUEST_URI} -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # 4. Route all remaining requests to Frontend Single Page Application (React)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ frontend/dist/index.html [L]
</IfModule>
